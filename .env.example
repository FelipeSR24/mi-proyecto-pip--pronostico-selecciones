# Plantilla de configuracion del proyecto.
# Copia este archivo como .env y ajusta los valores si lo necesitas.
# NOTA: el pipeline actual usa estos valores como constantes al inicio de
# main.py. Este archivo queda como plantilla para cuando automatices la
# extraccion o agregues una base de datos (p. ej. credenciales de Kaggle o
# la URL de la base de datos).

# Carpeta donde colocas los CSV
DATA_DIR=datasets

# Año desde el cual se filtran los partidos
START_YEAR=2000

# Numero de partidos previos para calcular la forma reciente
FORM_WINDOW=5

# (Futuro) ruta de la base de datos SQLite
# DATABASE_URL=sqlite:///mundial.db
