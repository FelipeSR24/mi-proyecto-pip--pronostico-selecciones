# Plantilla de configuracion del proyecto.
# Copia este archivo como .env y ajusta los valores si lo necesitas:
#   cp .env.example .env        (Linux/macOS)
#   copy .env.example .env      (Windows)
#
# main.py LEE estas variables al iniciar (via python-dotenv). Si el archivo
# .env no existe o falta alguna variable, se usan los valores por defecto.

# Carpeta donde colocas los CSV descargados de Kaggle
DATA_DIR=datasets

# Carpeta donde se escriben el dataset final y las figuras del EDA
OUTPUT_DIR=output

# Anio desde el cual se filtran los partidos
START_YEAR=2000

# Numero de partidos previos para calcular la forma reciente
FORM_WINDOW=5

# (Futuro) ruta de la base de datos SQLite y credenciales de Kaggle
# DATABASE_URL=sqlite:///mundial.db
# KAGGLE_USERNAME=
# KAGGLE_KEY=
